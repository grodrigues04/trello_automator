# Trello: lido e atualizado pelo plugin "claude.ai Trello" do Claude Code (autenticar com /mcp)
TRELLO_BOARD_NAME=Squeaker
TRELLO_LIST_NAME=GUSTAVO

# personalWhats: mesma URI e senha de criptografia do personalWhats/.env
MONGO_URI=
ENCRYPTION_PASSWORD=

# JID do grupo Squeaker no WhatsApp (...@g.us). O grupo Claudio é o contato padrão do personalWhats
SQUEAKER_GROUP=

# Repositório onde o Claude implementa as tasks
REPO_PATH=/home/vip-2002/MyProjects/ratUFSC
GITHUB_REPO=matheusfaustinott/ratUFSC

# Modelos: avaliação (complexidade e risco) e implementação
EVALUATION_MODEL=claude-sonnet-5-5
IMPLEMENTATION_MODEL=claude-opus-5-5
IMPLEMENTATION_TIMEOUT_MINUTES=240
IMPLEMENTATION_MAX_TURNS=400
