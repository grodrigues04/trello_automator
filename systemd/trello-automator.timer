[Unit]
Description=trello_automator: segunda 12:00, quinta 22:30, sexta 22:00

[Timer]
OnCalendar=Mon *-*-* 12:00:00
OnCalendar=Thu *-*-* 22:30:00
OnCalendar=Fri *-*-* 22:00:00
# Computer off or suspended at the time: the session is lost, no catch-up
Persistent=false

[Install]
WantedBy=timers.target
